<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.edu.rpm</groupId>
        <artifactId>rpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rpm-file</artifactId>
    <name>rpm-file</name>
    <description>文件元数据、对象存储、下载鉴权、病毒扫描钩子（Batch-5）</description>

    <dependencies>
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-common</artifactId>
        </dependency>
        <!-- 任务拆解模块依赖图 rpm-file —→ rpm-iam（下载前业务授权复用统一 AuthorizationService） -->
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-iam</artifactId>
        </dependency>
        <!-- 数据访问：MyBatis-Plus（运行期数据源/拦截器由 rpm-boot 装配） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 对象存储：MinIO Java SDK（版本由父 POM dependencyManagement 统一管理） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <!-- MinIO 传递声明的 okhttp 5.x 为 KMP 元数据空包，Maven 消费需显式引入 JVM 产物 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
