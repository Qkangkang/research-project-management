<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.edu.rpm</groupId>
    <artifactId>rpm-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>rpm-parent</name>
    <description>科研项目全生命周期管理系统 — 父 POM（形态 A 模块化单体）</description>

    <modules>
        <module>rpm-common</module>
        <module>rpm-iam</module>
        <module>rpm-organization</module>
        <module>rpm-application</module>
        <module>rpm-workflow</module>
        <module>rpm-project</module>
        <module>rpm-execution</module>
        <module>rpm-funding</module>
        <module>rpm-output</module>
        <module>rpm-acceptance</module>
        <module>rpm-reporting</module>
        <module>rpm-notification</module>
        <module>rpm-integration</module>
        <module>rpm-audit</module>
        <module>rpm-file</module>
        <module>rpm-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <!-- Batch-5：MinIO SDK 版本（技术文档未指定，经人工确认取 8.x 最新稳定线 8.6.0） -->
        <minio.version>8.6.0</minio.version>
        <!-- Batch-5：OkHttp JVM 产物版本；与 MinIO 8.6.0 传递依赖的 okhttp 5.1.0 保持一致。
             okhttp 5.x 的 com.squareup.okhttp3:okhttp 为 Kotlin 多平台元数据空包，Maven 无法解析
             Gradle 变体，实际 JVM 类位于 okhttp-jvm，故需显式引入。 -->
        <okhttp.version>5.1.0</okhttp.version>
        <!-- Batch-6：Flowable 7.x 内嵌工作流引擎（技术文档 README §4 / 03 §3.1）。
             技术文档未指定补丁版本，经人工确认锁定 7.2.0：其官方基线为 Spring Boot 3.5.4 /
             Spring Framework 6.2.10，与本项目 Spring Boot 3.5.x 同代（任务拆解 R-03）。 -->
        <flowable.version>7.2.0</flowable.version>
        <!-- Batch-6 收尾：集成验证用嵌入式 PostgreSQL（Zonky 发行版，无需 Docker）。
             院方目标版本为 PostgreSQL 16.x，故固定 16.x 二进制，主版本与生产一致。 -->
        <embedded-postgres.version>2.2.2</embedded-postgres.version>
        <embedded-postgres-binaries.version>16.16.0</embedded-postgres-binaries.version>
        <!-- V10：JWT 认证支持（io.jsonwebtoken:jjwt-api + impl + jackson） -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 3.5.x BOM：统一管理 Web/Redis/Actuator/Flyway/驱动/测试等版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- MyBatis-Plus 3.5.x（Spring Boot 3 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 3.5.9+ 将分页等 jsqlparser 相关插件拆分至独立模块 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Batch-5：对象存储 MinIO Java SDK（技术文档 06 §4 / 任务 T-FILE-003；版本经人工确认锁定 8.6.0） -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- Batch-5：OkHttp JVM 类（MinIO 传递依赖 okhttp 5.x 的 Maven 可见空包问题，见 properties 注释） -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <!-- Batch-6：Flowable 7.x 内嵌流程引擎（独立 flowable schema，V03/V09 管理 ACT_* 表） -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter-process</artifactId>
                <version>${flowable.version}</version>
            </dependency>
            <!-- Batch-6 收尾：集成测试用嵌入式 PostgreSQL（仅 test 作用域，禁止进入运行时） -->
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- 非 Windows 开发机（Linux/macOS）也可执行同一集成测试 -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- MyBatis-Plus 注解包：rpm-common BaseEntity（T-DB-008）所需的轻量注解，不引入 ORM 运行时 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 核心：仅供 rpm-common 单测模拟审计填充契约（TableInfo/strictFill）使用 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 本项目模块间引用统一由父 POM 管版本 -->
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Batch-4：rpm-iam 数据范围解析依赖组织数据（模块依赖图 rpm-iam ─→ rpm-organization） -->
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-organization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Batch-5：rpm-audit / rpm-file 复用统一授权与审计主体（模块依赖图 rpm-audit/rpm-file ─→ rpm-iam） -->
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-iam</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Batch-9：申报提交链路依赖工作流端口、审计记录器与文件可用性校验
                 （模块依赖图 rpm-application ─→ rpm-workflow / rpm-audit / rpm-file） -->
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Batch-11/12：立项创建端口（ProjectCreationPort）由 rpm-application 定义、
                 rpm-project 实现；rpm-execution 以 rpm-project 为主档依赖（01 §2.2 模块协作图） -->
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.edu.rpm</groupId>
                <artifactId>rpm-execution</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- V10：JWT 认证库（jjwt-api + impl + jackson，三者必须同时引入） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Spring MVC 对未显式声明 name 的 @RequestParam/@PathVariable 依赖参数名元数据；
                 本项目未继承 spring-boot-starter-parent，需要显式开启 -parameters。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
