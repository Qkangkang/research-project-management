<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.edu.rpm</groupId>
        <artifactId>rpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rpm-iam</artifactId>
    <name>rpm-iam</name>
    <description>用户、角色、权限、临时授权、SSO 绑定（Batch-3 数据层；Batch-4 授权核心服务）</description>

    <dependencies>
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-common</artifactId>
        </dependency>
        <!-- Batch-4：数据范围解析需要组织树/人员归属（任务拆解模块依赖图 rpm-iam ─→ rpm-organization） -->
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-organization</artifactId>
        </dependency>
        <!-- 数据访问：MyBatis-Plus（含 mybatis 与 @Mapper 注解；运行期拦截器/数据源由 rpm-boot 装配） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Batch-4：权限注解 AOP（@RequirePermission 前置校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- Batch-4：权限快照短期缓存（Redis 5 分钟，技术文档 06 §1.1） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Batch-4：权限快照 JSON 序列化（版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- V10：JWT 认证支持 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- V10：BCrypt 密码加密（spring-security-crypto，不引入完整 Spring Security） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- V10：参数校验（jakarta.validation.constraints） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
