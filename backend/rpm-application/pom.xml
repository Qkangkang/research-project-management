<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.edu.rpm</groupId>
        <artifactId>rpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rpm-application</artifactId>
    <name>rpm-application</name>
    <description>申报批次、申报书、版本、形式审查、外部项目登记</description>

    <dependencies>
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-common</artifactId>
        </dependency>
        <!-- 统一授权（应用服务入口 check，不能只靠 Controller 注解） -->
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-iam</artifactId>
        </dependency>
        <!-- 提交申报启动审批：只依赖 WorkflowPort / 模板路由，不直接操作 Flowable 表 -->
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-workflow</artifactId>
        </dependency>
        <!-- 关键动作审计（申报创建/提交与业务同事务提交、同回滚） -->
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-audit</artifactId>
        </dependency>
        <!-- 提交前附件可用性校验（只保存 file_id，文件本体在 rpm-file） -->
        <dependency>
            <groupId>cn.edu.rpm</groupId>
            <artifactId>rpm-file</artifactId>
        </dependency>
        <!-- 请求 DTO JSR-303 校验（版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 数据访问：MyBatis-Plus（含 BaseMapper/@Mapper 注解；
             运行期数据源/拦截器/Mapper 扫描由 rpm-boot 装配） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
